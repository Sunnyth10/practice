# Set false to disable automatic replies
AUTO_REPLY_ENABLED=true

# Default reply text when no keyword reply matches
AUTO_REPLY_TEXT=Hi! I am currently unavailable. I will get back to you soon.

# Set true if you want to auto-reply in WhatsApp groups
REPLY_IN_GROUPS=false

# Optional keyword-based replies as JSON object
# Example: {"hello":"Hi there!","price":"I will share details soon."}
KEYWORD_REPLIES={}

# Optional outbound messages sent immediately after login.
# Format: chat_id:message;chat_id:message
# Example: 911234567890@c.us:Hello from automation
OUTBOUND_MESSAGES=

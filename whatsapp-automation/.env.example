# Optional: keep multiple sessions separate
SESSION_ID=personal

# Set false to run with a visible browser
HEADLESS=true

# Set false to disable auto-reply
AUTO_REPLY_ENABLED=true

# Reply text for new incoming chats
AUTO_REPLY_TEXT=Hi! Thanks for your message. I will get back to you soon.

# Optional: only auto-reply to messages starting with this prefix
REQUIRED_PREFIX=

# Optional startup messages format:
# contact|message,contact|message
# Example: 919999999999@c.us|Hello from automation
STARTUP_MESSAGES=
